#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Servo.h>

// OLED display configuration
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Pin Definitions
const int buttonOpenPin  = 2;
const int buttonClosePin = 3;
const int greenLedPin    = 4;
const int redLedPin      = 5;
const int buzzerPin      = 6;
const int servoPin       = 9;

Servo gateServo;

void setup() {
  // Initialize Serial Monitor
  Serial.begin(9600);

  // Initialize Pins
  pinMode(buttonOpenPin, INPUT_PULLUP);
  pinMode(buttonClosePin, INPUT_PULLUP);
  pinMode(greenLedPin, OUTPUT);
  pinMode(redLedPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);

  // Initialize Servo
  gateServo.attach(servoPin);
  gateServo.write(0); // Start with gate closed (0 degrees)

  // Initialize OLED Display
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { 
    Serial.println(F("SSD1306 allocation failed"));
    for(;;); // Don't proceed, loop forever
  }
  
  // Initial Status Display
  updateDisplay("GATE SECURED", "Status: CLOSED");
  digitalWrite(redLedPin, HIGH);
  digitalWrite(greenLedPin, LOW);
}

void loop() {
  // Read button states (LOW means pressed due to INPUT_PULLUP)
  bool openPressed = (digitalRead(buttonOpenPin) == LOW);
  bool closePressed = (digitalRead(buttonClosePin) == LOW);

  // Action: Open the Gate
  if (openPressed) {
    updateDisplay("ACTION: OPENING", "Please Wait...");
    
    // Play Retro Arcade "Coin Up" sound effect
    tone(buzzerPin, 523, 80); // Note C5
    delay(90);
    tone(buzzerPin, 659, 80); // Note E5
    delay(90);
    tone(buzzerPin, 784, 80); // Note G5
    delay(90);
    tone(buzzerPin, 1047, 150); // Note C6
    delay(160);
    noTone(buzzerPin);
    
    // Move Servo to 90 degrees
    gateServo.write(90);
    
    // Toggle LEDs
    digitalWrite(redLedPin, LOW);
    digitalWrite(greenLedPin, HIGH);
    
    updateDisplay("ACCESS GRANTED", "Status: OPEN");
    delay(500); // Debounce / buffer delay
  }

  // Action: Close the Gate
  if (closePressed) {
    updateDisplay("ACTION: CLOSING", "Please Wait...");
    
    // Play Sci-Fi Laser Sweep Down noise
    for (int freq = 1300; freq > 400; freq -= 30) {
      tone(buzzerPin, freq, 15);
      delay(3);
    }
    noTone(buzzerPin);
    
    // Move Servo back to 0 degrees
    gateServo.write(0);
    
    // Toggle LEDs
    digitalWrite(greenLedPin, LOW);
    digitalWrite(redLedPin, HIGH);
    
    updateDisplay("GATE SECURED", "Status: CLOSED");
    delay(500); // Debounce / buffer delay
  }
}

// Helper function to handle OLED text updates
void updateDisplay(String title, String status) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  // Header Text
  display.setCursor(10, 10);
  display.print(title);
  
  // Divider line
  display.drawFastHLine(0, 25, 128, SSD1306_WHITE);
  
  // Status Text
  display.setCursor(10, 40);
  display.print(status);
  
  display.display();
}
